# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

*-deprecated*

# dependencies
/node_modules/
*/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
*/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
public/queries.sql
file-structure.txt

# Database backup exports (contains sensitive data)
scripts/database/data/

# But allow sample data for local development (optional)
# If you want to version control your local data, comment out the line above

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
*/.env*
# But keep .env.example files if you have them
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma
