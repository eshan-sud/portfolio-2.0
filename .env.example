# For regular mode
NEXT_PUBLIC_MAINTENANCE_MODE="false"
# For maintenance mode:
# NEXT_PUBLIC_MAINTENANCE_MODE="true"

# DATA SOURCE TOGGLE (select only one of them)
# Set to 'local' to use local JSON files (Only for maintenance mode or development)
# NEXT_PUBLIC_DATA_SOURCE="local"

# Set to 'supabase' to use live Supabase database
# NEXT_PUBLIC_DATA_SOURCE="supabase"

# Supabase - PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# For local development or maintenace mode only
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cloudinary (for images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# GitHub API - used for the activity graph on the About page
GITHUB_TOKEN="your-github-token-here"

# Vercel KV (Redis) - Optional, for production rate limiting
# In development, rate limiter uses in-memory storage
# Get these from Vercel Dashboard > Storage > KV > .env.local tab
# KV_REST_API_URL="your-kv-rest-api-url"
# KV_REST_API_TOKEN="your-kv-rest-api-token"
# KV_REST_API_READ_ONLY_TOKEN="your-kv-read-only-token"