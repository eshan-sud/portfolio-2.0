# For maintenance mode
NEXT_PUBLIC_MAINTENANCE_MODE="false" # "true"
# DATA SOURCE TOGGLE
# Set to 'local' to use local JSON files
# Set to 'supabase' to use live Supabase database
NEXT_PUBLIC_DATA_SOURCE="local" # "local" or "supabase"

# Supabase - PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL="url-to-your-supabase-instance"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

######

NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # Only needed for import/export scripts, not used in frontend
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="your-supabase-storage-bucket-name" # e.g. "project-assets"

# Cloudinary (for images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your-cloudinary-api-key"
NEXT_PUBLIC_CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_API_ENVIRONMENT_VARIABLE="your-cloudinary-env-variable-name" # e.g. "CLOUDINARY_URL"

# Next Auth (if you add admin authentication later)
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# GitHub API — used for the activity graph on the About page
# Create a classic PAT at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN="your-github-personal-access-token"

# Vercel KV (Redis) - Optional, for production rate limiting
# In development, rate limiter uses in-memory storage
# Get these from Vercel Dashboard > Storage > KV > .env.local tab
# KV_REST_API_URL="your-kv-rest-api-url"
# KV_REST_API_TOKEN="your-kv-rest-api-token"
# KV_REST_API_READ_ONLY_TOKEN="your-kv-read-only-token"
